# Comma-separated @im.wechat user ids. Empty: bind the first inbound sender.
WEIXIN_ALLOW_FROM=

# Absolute path to agent.cmd / agent (optional; auto-detected on Windows)
CURSOR_CLI_PATH=

CURSOR_CLI_MODEL=auto

# Workspace the local Cursor agent works in
CURSOR_WORKSPACE=d:\workspace\jinpai\backend

# iLink text hard cap is ~2000; stay under it
WECHAT_MAX_CHARS=1800

# Scheduled jobs: copy jobs.example.yaml → jobs.yaml (gitignored)

